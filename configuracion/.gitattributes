# Auto detect text files and perform LF normalization
* text=auto

# Python source files
*.py text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.json text eol=lf

# Windows batch files
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.gguf binary
*.bin binary
*.zip binary
*.tar.gz binary
*.db binary
